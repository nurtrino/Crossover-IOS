+        AC_SUBST(DISKARBITRATION_LIBS,"")
+        AC_SUBST(IOKIT_LIBS,"-framework CoreFoundation")
+        AC_SUBST(APPLICATIONSERVICES_LIBS,"")
+        AC_SUBST(CORESERVICES_LIBS,"")
+        AC_SUBST(APPKIT_LIBS,"")
+        AC_SUBST(SECURITY_LIBS,"-framework Security -framework CoreFoundation")
+        AC_SUBST(SYSTEMCONFIGURATION_LIBS,"")
+    else
     enable_winemac_drv=${enable_winemac_drv:-yes}
     dnl declare needed frameworks
     AC_SUBST(CORETEXT_LIBS,"-framework CoreText")
@@ -936,6 +964,7 @@ case $host_os in
