     LIBEXT="dylib"
     DLLFLAGS="$DLLFLAGS -fPIC"
     LDDLLFLAGS="-fPIC"
+    dnl Crossover-IOS fork, patch 0007: distinguish iOS from macOS. The host
+    dnl triplet (aarch64-apple-darwin) is identical for both, so probe the SDK
+    dnl via TargetConditionals. On iOS the AppKit-based winemac driver and
+    dnl several macOS-only frameworks (AppKit, DiskArbitration, IOKit-as-
+    dnl framework, ApplicationServices, CoreServices) do not exist; blank them
+    dnl and disable winemac_drv. The Metal/UIKit display driver is future work.
+    AC_CACHE_CHECK([whether we are building for iOS],[wine_cv_target_ios],
+      [AC_COMPILE_IFELSE([AC_LANG_PROGRAM([[#include <TargetConditionals.h>
+#if !TARGET_OS_IPHONE
+#error not ios
+#endif]],[[]])],[wine_cv_target_ios=yes],[wine_cv_target_ios=no])])
+    if test "x$wine_cv_target_ios" = xyes
+    then
+        enable_winemac_drv=${enable_winemac_drv:-no}
+        dnl winecoreaudio.drv drives the macOS CoreAudio HAL (AudioObject*
+        dnl property API), which does not exist on iOS — iOS uses AVAudioSession
+        dnl instead. Disable it here; audio support is future work.
+        enable_winecoreaudio_drv=${enable_winecoreaudio_drv:-no}
