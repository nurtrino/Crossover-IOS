+
+#ifdef USE_INPROC_TRACE
+
+/*
+ * Crossover-IOS fork, patch 0006: in-process tracing backend for iOS.
+ *
+ * All pseudo-processes live in the server's own task and address space
+ * (patches 0003/0005), so "another process's" memory is simply our memory:
+ * read/write are direct copies. The ptrace/Mach suspend-and-inspect plumbing
+ * that a cross-process debugger needs is not applicable here and is stubbed;
+ * server-side debugging of an in-process child is future work (it would read
+ * the child thread's TEB-saved context directly rather than via the kernel).
+ */
+
+void sigchld_callback(void)
+{
+}
+
+void init_tracing_mechanism(void)
+{
+}
+
+void init_process_tracing( struct process *process )
+{
+}
+
+void finish_process_tracing( struct process *process )
+{
+}
+
+void init_thread_context( struct thread *thread )
+{
+}
+
+void get_thread_context( struct thread *thread, struct context_data *context, unsigned int flags )
+{
+    /* not supported in-process yet: leave the caller's context unchanged */
+}
+
+void set_thread_context( struct thread *thread, const struct context_data *context, unsigned int flags )
+{
+}
+
+int send_thread_signal( struct thread *thread, int sig )
+{
+    /* in-process threads are not signalled individually here */
+    return 0;
+}
+
+int read_process_memory( struct process *process, client_ptr_t ptr, data_size_t size, char *dest )
+{
+    /* shared address space: the client pointer is valid in our own space */
+    if ((client_ptr_t)(uintptr_t)ptr != ptr) return 0;
+    memcpy( dest, (const void *)(uintptr_t)ptr, size );
+    return 1;
+}
+
+int write_process_memory( struct process *process, client_ptr_t ptr, data_size_t size,
+                          const char *src, data_size_t *written )
+{
+    if ((client_ptr_t)(uintptr_t)ptr != ptr) return 0;
+    memcpy( (void *)(uintptr_t)ptr, src, size );
+    if (written) *written = size;
+    return 1;
+}
+
+#endif  /* USE_INPROC_TRACE */
