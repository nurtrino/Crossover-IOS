+/***********************************************************************
+ *           iOS x18/TEB signal-resume trampoline
+ *
+ * Crossover-IOS fork, patch 0006. The iOS kernel zeroes x18 on sigreturn
+ * (measured), so Wine cannot deliver the Windows TEB register to a user-mode
+ * entry point (KiUserExceptionDispatcher, the syscall-dispatcher return) via
+ * the signal context — the entry would run with x18 = 0 and fault reading the
+ * TEB, recursing until the stack overflows. Resume instead at this trampoline:
+ * the kernel *does* restore the ordinary GPRs, so setup stashes the TEB in x9
+ * and the real entry point in x10; the trampoline restores x18 and tail-calls.
+ * Both call sites target function entries, which do not expect x9/x10 to be
+ * preserved, so clobbering them is safe. No-op on macOS/Linux.
+ */
+#if defined(__APPLE__) && !TARGET_OS_OSX
+extern void __wine_ios_teb_trampoline(void);
+/* The kernel restores every GPR except x18 (special-cased to 0) on sigreturn.
+ * resume_with_teb stashes the TEB in x16 and the real resume PC in x17; here
+ * we move x16 into x18 and branch to x17. Pure register handoff — no memory. */
+__ASM_GLOBAL_FUNC( __wine_ios_teb_trampoline,
+                   "mov x18, x16\n\t"          /* TEB (kernel restored x16) */
+                   "br x17" )                     /* real resume PC */
+#endif
+
+/* Set the signal context to resume at PC with x18 = TEB. On iOS the kernel
+ * zeroes x18 on sigreturn regardless of the sigcontext (measured), so route
+ * the resume through a trampoline that reloads x18 from the stack; elsewhere
+ * set x18 directly. Works for both a Windows-side entry point and re-executing
+ * an interrupted instruction, since it clobbers only x16. */
+static inline void resume_with_teb( ucontext_t *sigcontext, ULONG_PTR pc, ULONG_PTR teb )
+{
+#if defined(__APPLE__) && !TARGET_OS_OSX
+    /* stash TEB and PC in x16/x17, which the kernel restores on sigreturn
+     * (only x18 is special-cased to 0); the trampoline moves x16->x18 and
+     * branches to x17. No memory stash -> nothing to corrupt. */
+    REGn_sig( 16, sigcontext ) = teb;
+    REGn_sig( 17, sigcontext ) = pc;
+    PC_sig( sigcontext ) = (ULONG_PTR)__wine_ios_teb_trampoline;
+#else
+    PC_sig( sigcontext ) = pc;
+    REGn_sig( 18, sigcontext ) = teb;
+#endif
+}
+
