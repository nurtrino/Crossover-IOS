+/***********************************************************************
+ *           spawn_process_inproc
+ *
+ * Crossover-IOS fork, patch series 0003 (in progress): launch the child in
+ * the SAME host process — a new pproc thread group loading the child PE into
+ * the shared address space and running its ntdll init on the already-
+ * connected `socketfd` — instead of fork/exec. iOS forbids fork/exec, so this
+ * is the only viable backend there.
+ *
+ * The server-side setup (new_process/new_thread, socket handoff) is done by
+ * the caller and works in-process already (proven by wineforge exp. 004), so
+ * only this function changes versus the fork backend. The substantive pieces
+ * — per-pseudo-process PEB/TEB, in-address-space PE mapping, and the child
+ * init_first_thread on `socketfd` — are staged as 0003b–d in
+ * docs/DESIGN-0003-inproc-spawn.md. Until they land this backend is a wired
+ * but unimplemented seam.
+ */
+static NTSTATUS spawn_process_inproc( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd,
+                                      int unixdir, char *winedebug, const struct pe_image_info *pe_info )
+{
+    /* 0003a: seam only. 0003c (image map) + 0003d (in-proc init) fill this in. */
+    ERR( "in-process spawn (WINE_INPROC_SPAWN) not yet implemented; "
+         "see docs/DESIGN-0003-inproc-spawn.md\n" );
+    return STATUS_NOT_IMPLEMENTED;
+}
+
+
+/***********************************************************************
+ *           spawn_process
+ *
+ * Dispatch to the in-process backend when requested (the iOS model), else
+ * the classic fork/exec backend. Selecting the backend here keeps the whole
+ * fork boundary for Windows process creation in one place.
+ */
+static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd,
+                               int unixdir, char *winedebug, const struct pe_image_info *pe_info )
+{
+    if (getenv( "WINE_INPROC_SPAWN" ))
+        return spawn_process_inproc( params, socketfd, unixdir, winedebug, pe_info );
+    return spawn_process_fork( params, socketfd, unixdir, winedebug, pe_info );
+}
+
