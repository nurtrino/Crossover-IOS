+         * builds its own process parameters, and maps its own main EXE into
+         * the shared address space — all through current_peb() /
+         * current_image_info(), so none of it touches the parent's state. */
+        status = init_startup_info_inproc( info_size );
+        if (!status)
+        {
+            BOOL suspend;
+
+            MESSAGE( "wine: in-process child image mapped: %s base=%p entry=%p\n",
+                     debugstr_us( &current_peb()->ProcessParameters->ImagePathName ),
+                     current_peb()->ImageBaseAddress,
+                     current_image_info()->TransferAddress );
+            /* only now may the server drop the staged startup info */
+            status = server_init_process_done_inproc( &suspend );
+        }
+        else ERR( "in-process child: failed to build startup info/image, status %x\n", status );
+    }
