+/***********************************************************************
+ *           spawn_process
+ *
+ * Dispatch to the in-process backend when requested (the iOS model), else
+ * the classic fork/exec backend. Selecting the backend here keeps the whole
+ * fork boundary for Windows process creation in one place.
+ */
+static NTSTATUS spawn_process( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd,
+                               int unixdir, char *winedebug, const struct pe_image_info *pe_info )
+{
+    /*
+     * The in-process backend runs the child on the shared ntdll, so it needs
+     * ntdll's PE side to be initialized: the child is entered through
+     * pRtlUserThreadStart / pLdrInitializeThunk, which the PE side publishes
+     * during its own init. Prefix bootstrap spawns wineboot BEFORE that has
+     * happened (a cold prefix is created from inside early init), and entering
+     * a child then jumps to a NULL entry and takes the host down.
+     *
+     * The same applies while the prefix itself is being created
+     * (is_prefix_bootstrap): the child's loader cannot resolve system DLLs
+     * from a prefix that does not exist yet.
+     *
+     * Neither case can be served in-process, so fall back to fork rather than
+     * fail: on the host that makes cold-prefix creation work normally. These
+     * are the model's real boundary — the in-process backend needs a live
+     * ntdll PE side and an initialized prefix. iOS has no fork, so it must
+     * ship a prepared prefix; tracked in docs/DESIGN-0003-inproc-spawn.md.
+     */
+    if (getenv( "WINE_INPROC_SPAWN" ))
+    {
+        if (!pRtlUserThreadStart || !pLdrInitializeThunk)
+            WARN( "in-process spawn requested before ntdll's PE side is initialized; "
+                  "using the fork backend for this child\n" );
+        else if (is_prefix_bootstrap)
+            WARN( "in-process spawn requested during prefix bootstrap; "
+                  "using the fork backend for this child\n" );
+        else
+            return spawn_process_inproc( params, socketfd, unixdir, winedebug, pe_info );
+    }
+    return spawn_process_fork( params, socketfd, unixdir, winedebug, pe_info );
+}
