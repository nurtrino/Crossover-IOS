+/*
+ * Crossover-IOS fork, patch series 0003e: per-pseudo-process main image info.
+ *
+ * main_image_info describes the process's main EXE (entry point, subsystem,
+ * stack sizes, machine). One address space now hosts several Windows
+ * processes, each with its own EXE, so "my process's image info" must be
+ * reached through the current PEB — the same shape as current_peb() and
+ * current_server_fd() (0003b). The primary process keeps using the global
+ * (nothing registers it), so every conversion is zero-behaviour-change today
+ * and correct for in-process children tomorrow.
+ *
+ * Guarded against a missing TEB: unlike current_peb(), this is reachable from
+ * early virtual.c paths that run before virtual_alloc_first_teb().
+ */
+#define MAX_PROC_IMAGES 64
+static struct { PEB *peb; SECTION_IMAGE_INFORMATION *info; } proc_image_infos[MAX_PROC_IMAGES];
+static pthread_mutex_t proc_image_infos_lock = PTHREAD_MUTEX_INITIALIZER;
+
+void set_process_image_info( PEB *owner, SECTION_IMAGE_INFORMATION *info )
+{
+    int free_slot = -1;
+
+    pthread_mutex_lock( &proc_image_infos_lock );
+    for (int i = 0; i < MAX_PROC_IMAGES; i++)
+    {
+        if (proc_image_infos[i].peb == owner)
+        {
+            proc_image_infos[i].peb = info ? owner : NULL;  /* NULL info unregisters */
+            proc_image_infos[i].info = info;
+            free_slot = -1;
+            break;
+        }
+        if (free_slot == -1 && !proc_image_infos[i].peb) free_slot = i;
+    }
+    if (free_slot != -1 && info)
+    {
+        proc_image_infos[free_slot].peb = owner;
+        proc_image_infos[free_slot].info = info;
+    }
+    pthread_mutex_unlock( &proc_image_infos_lock );
+}
+
+SECTION_IMAGE_INFORMATION *current_image_info(void)
+{
+    SECTION_IMAGE_INFORMATION *ret = &main_image_info;
+    TEB *teb = NtCurrentTeb();
+    PEB *cur;
+
+    if (!teb) return ret;  /* pre-first-TEB init: the global is the only one */
+    cur = (PEB *)teb->Peb;
+    pthread_mutex_lock( &proc_image_infos_lock );
+    for (int i = 0; i < MAX_PROC_IMAGES; i++)
+        if (proc_image_infos[i].peb == cur) { ret = proc_image_infos[i].info; break; }
+    pthread_mutex_unlock( &proc_image_infos_lock );
+    return ret;
+}
+
