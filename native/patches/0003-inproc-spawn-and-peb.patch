+/*
+ * Crossover-IOS fork, patch series 0003b: per-pseudo-process PEB indirection.
+ *
+ * The global `peb` is the single process control block — fine while one
+ * Windows process owns the address space, but the in-process model
+ * (docs/DESIGN-0003-inproc-spawn.md) runs several. Each pseudo-process's
+ * threads carry their own PEB in TEB->Peb, so post-init code that means "my
+ * process's PEB" should use current_peb() instead of the global. For the
+ * first/primary process the two are identical (init_teb sets teb->Peb = peb),
+ * so converting a call site is a zero-behavior-change step today and the
+ * hook for per-pseudo-process PEBs tomorrow.
+ *
+ * NB: only valid once the current thread has a TEB. Early-init code that runs
+ * before virtual_alloc_first_teb() must keep using the global `peb`.
+ */
+static inline PEB *current_peb(void)
+{
+    return (PEB *)NtCurrentTeb()->Peb;
+}
