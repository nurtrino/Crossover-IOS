+    set_process_image_info( child_peb, NULL );
+    if (socketfd != -1) close( socketfd );
+    /* the TEB (and its kernel stack, which is this pthread's stack) is
+     * deliberately leaked: freeing it out from under a live thread is worse.
+     * NtTerminateProcess-grade unwind is tracked in docs/NATIVE_PORT.md. */
+    return NULL;
+}
+
+static NTSTATUS spawn_process_inproc( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd,
+                                      int unixdir, char *winedebug, const struct pe_image_info *pe_info )
+{
+    NTSTATUS status;
+    PEB *child_peb;
+    SECTION_IMAGE_INFORMATION *child_image_info;
+    TEB *teb;
+    struct ntdll_thread_data *thread_data;
+    pthread_t pthread_id;
+    pthread_attr_t pthread_attr;
+    sigset_t sigset;
+    int fd;
+
+    /* the caller closes socketfd once we return; the child keeps its own */
+    if ((fd = dup( socketfd )) == -1) return STATUS_TOO_MANY_OPENED_FILES;
+    fcntl( fd, F_SETFD, FD_CLOEXEC );
+
+    /* Child PEB: template-copy the parent's, then reset what is genuinely
+     * per-process. The shared fields (session/config data initialized by the
+     * shared ntdll) stay valid by construction; LdrData and ProcessParameters
+     * become the child's own when 0003e maps its image and clones params. */
+    child_peb = anon_mmap_alloc( page_size, PROT_READ | PROT_WRITE );
+    if (child_peb == MAP_FAILED)
+    {
+        close( fd );
+        return STATUS_NO_MEMORY;
+    }
+    *child_peb = *current_peb();
+    /* Both become the child's own: ProcessParameters in
+     * init_startup_info_inproc, LdrData when the PE-side loader installs this
+     * process's own loader state (0003g). NULL is the signal that this
+     * pseudo-process has no loader state yet. */
+    child_peb->ProcessParameters = NULL;
+    child_peb->LdrData           = NULL;
+
+    /* the child's own main-image info: its EXE, not the parent's */
+    child_image_info = anon_mmap_alloc( page_size, PROT_READ | PROT_WRITE );
+    if (child_image_info == MAP_FAILED)
+    {
+        munmap( child_peb, page_size );
+        close( fd );
+        return STATUS_NO_MEMORY;
+    }
+    memset( child_image_info, 0, sizeof(*child_image_info) );
+
+    set_process_server_fd( child_peb, fd );
+    set_process_image_info( child_peb, child_image_info );
+
+    pthread_sigmask( SIG_BLOCK, &server_block_set, &sigset );
+
+    if ((status = virtual_alloc_teb( &teb ))) goto failed;
+    teb->Peb = child_peb;  /* the thread's process identity: current_peb() now
+                            * resolves to the child for this thread */
+    if ((status = init_thread_stack( teb, 0, 0, 0 )))
+    {
+        virtual_free_teb( teb );
+        goto failed;
+    }
+    thread_data = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+    thread_data->request_fd = -1;  /* received from the server socket by the child */
+
+    pthread_attr_init( &pthread_attr );
+    pthread_attr_setstack( &pthread_attr, thread_data->kernel_stack, kernel_stack_size );
+    pthread_attr_setguardsize( &pthread_attr, 0 );
+    pthread_attr_setscope( &pthread_attr, PTHREAD_SCOPE_SYSTEM );
+    if (pthread_create( &pthread_id, &pthread_attr, inproc_process_thread, teb ))
+    {
+        pthread_attr_destroy( &pthread_attr );
+        virtual_free_teb( teb );
+        status = STATUS_NO_MEMORY;
+        goto failed;
+    }
+    pthread_attr_destroy( &pthread_attr );
+    pthread_sigmask( SIG_SETMASK, &sigset, NULL );
+
+    TRACE( "in-process child spawned, socket %d -> %d\n", socketfd, fd );
+    return STATUS_SUCCESS;
+
+failed:
+    pthread_sigmask( SIG_SETMASK, &sigset, NULL );
+    set_process_server_fd( child_peb, -1 );
+    set_process_image_info( child_peb, NULL );
+    munmap( child_image_info, page_size );
+    munmap( child_peb, page_size );
+    close( fd );
+    return status;
+}
