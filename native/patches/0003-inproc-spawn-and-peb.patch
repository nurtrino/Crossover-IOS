+/***********************************************************************
+ *           server_init_process_inproc
+ *
+ * Crossover-IOS fork, patch series 0003d: first-thread handshake for an
+ * in-process child (docs/DESIGN-0003-inproc-spawn.md). Runs on the child
+ * pseudo-process's initial thread, whose TEB->Peb is the child PEB and whose
+ * server socket was registered with set_process_server_fd() — so every
+ * send/receive below rides the child's own connection.
+ *
+ * This is the per-process tail of server_init_process() only: the one-time
+ * global init (environment, cpu info, machine tables, signal masks) already
+ * ran in the shared ntdll and must not run again. Unlike the primary-process
+ * path this returns errors instead of calling fatal_error(): a failed child
+ * attach must not take down the host.
+ */
+NTSTATUS server_init_process_inproc(void)
+{
+    struct ntdll_thread_data *data = ntdll_get_thread_data();
+    obj_handle_t version = 0;
+    unsigned short machines[8];
+    obj_handle_t inproc_device = 0;
+    unsigned int status;
+    int ret, reply_pipe;
+    DWORD pid = 0, tid = 0, session_id = 0;
+
+    /* The server queued the protocol version + this thread's request pipe on
+     * the process socket when the parent's new_thread request created the
+     * first thread (server/thread.c: create_thread, request_fd == -1). */
+    data->request_fd = wine_server_receive_fd( &version );
+    if (data->request_fd == -1 || version != SERVER_PROTOCOL_VERSION)
+    {
+        ERR( "in-process child: bad first-thread handshake (fd %d, version %d/%d)\n",
+             data->request_fd, (int)version, SERVER_PROTOCOL_VERSION );
+        return STATUS_INTERNAL_ERROR;
+    }
+
+    reply_pipe = init_thread_pipe();
+
+    SERVER_START_REQ( init_first_thread )
+    {
+        req->unix_pid    = getpid();  /* shared with every pseudo-process; see design doc risks */
+        req->unix_tid    = get_unix_tid();
+        req->reply_fd    = reply_pipe;
+        req->wait_fd     = data->wait_fd[1];
+        req->debug_level = (TRACE_ON(server) != 0);
+        /* reply into a local buffer: the machine list is a property of the
+         * shared ntdll and is already initialized — leave the globals alone */
+        wine_server_set_reply( req, machines, sizeof(machines) );
+        if (!(ret = wine_server_call( req )))
+        {
+            pid           = reply->pid;
+            tid           = reply->tid;
+            session_id    = reply->session_id;
+            inproc_device = reply->inproc_device;
+        }
+    }
+    SERVER_END_REQ;
+    close( reply_pipe );
+    if (ret)
+    {
+        ERR( "in-process child: init_first_thread failed, status %x\n", ret );
+        return ret;
+    }
+
+    if (inproc_device)
+    {
+        /* consume the per-process device fd queued behind the reply; the
+         * shared ntdll already holds one for the address space */
+        obj_handle_t handle;
+        int fd = wine_server_receive_fd( &handle );
+        if (fd != -1) close( fd );
+    }
+
+    current_peb()->SessionId = session_id;
+    set_thread_id( NtCurrentTeb(), pid, tid );
+
+    /* releases the parent blocked on process_info in NtCreateUserProcess */
+    SERVER_START_REQ( init_process_done )
+    {
+        req->teb = wine_server_client_ptr( NtCurrentTeb() );
+        req->peb = wine_server_client_ptr( current_peb() );
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    if (status) ERR( "in-process child: init_process_done failed, status %x\n", status );
+    return status;
 }
 
 
