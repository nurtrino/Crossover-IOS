+/*
+ * Crossover-IOS fork, patch series 0003b: per-pseudo-process server socket.
+ *
+ * fd_socket is the SCM_RIGHTS fd-exchange socket, one per Windows process.
+ * The in-process model (docs/DESIGN-0003-inproc-spawn.md) runs several
+ * processes in one host process, so each needs its own — otherwise a child's
+ * init would clobber the parent's connection. The socket is per-process, so
+ * we key it on the PEB (all of a process's threads share one PEB, reached via
+ * current_peb()). The primary process registers itself at server_init_process
+ * time; current_server_fd() falls back to the global fd_socket before that
+ * registration (early init) and if a lookup ever misses.
+ */
+#define MAX_PROC_FDS 64
+static struct { PEB *peb; int fd; } proc_server_fds[MAX_PROC_FDS];
+static pthread_mutex_t proc_server_fds_lock = PTHREAD_MUTEX_INITIALIZER;
+
+void set_process_server_fd( PEB *owner, int fd )
+{
+    int free_slot = -1;
+
+    pthread_mutex_lock( &proc_server_fds_lock );
+    for (int i = 0; i < MAX_PROC_FDS; i++)
+    {
+        if (proc_server_fds[i].peb == owner)
+        {
+            /* fd == -1 unregisters (in-process child exit); leave no hole
+             * semantics to worry about — the lookup scans every slot */
+            proc_server_fds[i].peb = (fd == -1) ? NULL : owner;
+            proc_server_fds[i].fd = fd;
+            free_slot = -1;
+            break;
+        }
+        if (free_slot == -1 && !proc_server_fds[i].peb) free_slot = i;
+    }
+    if (free_slot != -1 && fd != -1)
+    {
+        proc_server_fds[free_slot].peb = owner;
+        proc_server_fds[free_slot].fd = fd;
+    }
+    pthread_mutex_unlock( &proc_server_fds_lock );
+}
+
+int current_server_fd(void)
+{
+    PEB *cur = current_peb();
+    int fd = fd_socket;  /* fallback for early init / primary process */
+    pthread_mutex_lock( &proc_server_fds_lock );
+    for (int i = 0; i < MAX_PROC_FDS; i++)
+        if (proc_server_fds[i].peb == cur) { fd = proc_server_fds[i].fd; break; }
+    pthread_mutex_unlock( &proc_server_fds_lock );
+    return fd;
+}
