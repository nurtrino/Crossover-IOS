+/***********************************************************************
+ *           server_init_process_done_inproc
+ *
+ * Crossover-IOS fork 0003e: the in-process child's init_process_done.
+ *
+ * Split from server_init_process_inproc deliberately: init_process_done makes
+ * the server drop the process's staged startup info (server/process.c,
+ * set_process_startup_state), so it MUST come after the child has fetched it
+ * with get_startup_info — the same order the normal loader uses
+ * (server_init_process -> init_startup_info -> server_init_process_done).
+ * Sending it releases the parent blocked on process_info in
+ * NtCreateUserProcess.
+ */
+NTSTATUS server_init_process_done_inproc( BOOL *suspend )
+{
+    unsigned int status;
+
+    SERVER_START_REQ( init_process_done )
+    {
+        req->teb = wine_server_client_ptr( NtCurrentTeb() );
+        req->peb = wine_server_client_ptr( current_peb() );
+        status = wine_server_call( req );
+        *suspend = reply->suspend;
+    }
+    SERVER_END_REQ;
+    if (status) ERR( "in-process child: init_process_done failed, status %x\n", status );
+    return status;
 }
 
 
