+/***********************************************************************
+ *           spawn_process_inproc
+ *
+ * Crossover-IOS fork, patch series 0003 (in progress): launch the child in
+ * the SAME host process — a new pproc thread group loading the child PE into
+ * the shared address space and running its ntdll init on the already-
+ * connected `socketfd` — instead of fork/exec. iOS forbids fork/exec, so this
+ * is the only viable backend there.
+ *
+ * The server-side setup (new_process/new_thread, socket handoff) is done by
+ * the caller and works in-process already (proven by wineforge exp. 004), so
+ * only this function changes versus the fork backend. The substantive pieces
+ * — per-pseudo-process PEB/TEB, in-address-space PE mapping, and the child
+ * init_first_thread on `socketfd` — are staged as 0003b–d in
+ * docs/DESIGN-0003-inproc-spawn.md. Until they land this backend is a wired
+ * but unimplemented seam.
+ */
+static void *inproc_process_thread( void *arg )
+{
+    TEB *teb = arg;
+    struct ntdll_thread_data *data = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+    PEB *child_peb = teb->Peb;
+    int socketfd;
+    NTSTATUS status;
+
+    data->pthread_id = pthread_self();
+    pthread_setspecific( teb_key, teb );
+
+    status = server_init_process_inproc();
+    if (!status)
+        MESSAGE( "wine: in-process child attached: pid=%04x tid=%04x\n",
+                 HandleToULong(teb->ClientId.UniqueProcess),
+                 HandleToULong(teb->ClientId.UniqueThread) );
+
+    /* 0003d stops after registration: the child is a first-class process on
+     * the shared server but runs no image yet — 0003e maps the child PE and
+     * enters it here. Detach cleanly: closing the thread/process fds is the
+     * same death signal a real child's exit gives the server, so the process
+     * object is reaped and handles/waits on it complete normally. */
+    socketfd = current_server_fd();
+    if (data->request_fd != -1) close( data->request_fd );
+    if (data->reply_fd != -1)   close( data->reply_fd );
+    if (data->wait_fd[0] != -1) close( data->wait_fd[0] );
+    if (data->wait_fd[1] != -1) close( data->wait_fd[1] );
+    set_process_server_fd( child_peb, -1 );
+    if (socketfd != -1) close( socketfd );
+    /* the TEB (and its kernel stack, which is this pthread's stack) is
+     * deliberately leaked: freeing it out from under a live thread is worse.
+     * NtTerminateProcess-grade unwind is tracked in docs/NATIVE_PORT.md. */
+    return NULL;
+}
+
+static NTSTATUS spawn_process_inproc( const RTL_USER_PROCESS_PARAMETERS *params, int socketfd,
+                                      int unixdir, char *winedebug, const struct pe_image_info *pe_info )
+{
+    NTSTATUS status;
+    PEB *child_peb;
+    TEB *teb;
+    struct ntdll_thread_data *thread_data;
+    pthread_t pthread_id;
+    pthread_attr_t pthread_attr;
+    sigset_t sigset;
+    int fd;
+
+    /* the caller closes socketfd once we return; the child keeps its own */
+    if ((fd = dup( socketfd )) == -1) return STATUS_TOO_MANY_OPENED_FILES;
+    fcntl( fd, F_SETFD, FD_CLOEXEC );
+
+    /* Child PEB: template-copy the parent's, then reset what is genuinely
+     * per-process. The shared fields (session/config data initialized by the
+     * shared ntdll) stay valid by construction; LdrData and ProcessParameters
+     * become the child's own when 0003e maps its image and clones params. */
+    child_peb = anon_mmap_alloc( page_size, PROT_READ | PROT_WRITE );
+    if (child_peb == MAP_FAILED)
+    {
+        close( fd );
+        return STATUS_NO_MEMORY;
+    }
+    *child_peb = *current_peb();
+    child_peb->LdrData           = NULL;  /* 0003e: per-process module list */
+    child_peb->ProcessParameters = NULL;  /* 0003e: cloned child params */
+
+    set_process_server_fd( child_peb, fd );
+
+    pthread_sigmask( SIG_BLOCK, &server_block_set, &sigset );
+
+    if ((status = virtual_alloc_teb( &teb ))) goto failed;
+    teb->Peb = child_peb;  /* the thread's process identity: current_peb() now
+                            * resolves to the child for this thread */
+    if ((status = init_thread_stack( teb, 0, 0, 0 )))
+    {
+        virtual_free_teb( teb );
+        goto failed;
+    }
+    thread_data = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+    thread_data->request_fd = -1;  /* received from the server socket by the child */
+
+    pthread_attr_init( &pthread_attr );
+    pthread_attr_setstack( &pthread_attr, thread_data->kernel_stack, kernel_stack_size );
+    pthread_attr_setguardsize( &pthread_attr, 0 );
+    pthread_attr_setscope( &pthread_attr, PTHREAD_SCOPE_SYSTEM );
+    if (pthread_create( &pthread_id, &pthread_attr, inproc_process_thread, teb ))
+    {
+        pthread_attr_destroy( &pthread_attr );
+        virtual_free_teb( teb );
+        status = STATUS_NO_MEMORY;
+        goto failed;
+    }
+    pthread_attr_destroy( &pthread_attr );
+    pthread_sigmask( SIG_SETMASK, &sigset, NULL );
+
+    TRACE( "in-process child spawned, socket %d -> %d\n", socketfd, fd );
+    return STATUS_SUCCESS;
+
+failed:
+    pthread_sigmask( SIG_SETMASK, &sigset, NULL );
+    set_process_server_fd( child_peb, -1 );
+    munmap( child_peb, page_size );
+    close( fd );
+    return status;
+}
