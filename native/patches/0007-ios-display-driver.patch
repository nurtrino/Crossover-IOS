diff --git a/dlls/wineios.drv/iosdrv_main.c b/dlls/wineios.drv/iosdrv_main.c
new file mode 100644
index 00000000..4821e5bf
--- /dev/null
+++ b/dlls/wineios.drv/iosdrv_main.c
@@ -0,0 +1,235 @@
+/*
+ * wineios.drv initialization and input pump
+ *
+ * Copyright 2026 the Crossover-IOS project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
