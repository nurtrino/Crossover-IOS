+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+
+#include "iosdrv.h"
+#include "ntuser.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+#include "wine/rbtree.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(iosdrv);
+
+/***********************************************************************
+ * per-window driver data
+ */
+
+struct ios_win_data
+{
+    struct rb_entry entry;      /* in win_data_rb, sorted by hwnd */
+    HWND hwnd;
+    struct window_rects rects;  /* window/client/visible, virtual-desktop coords */
+    uint64_t surface_id;        /* current surface, 0 if none */
+};
+
+static int ios_win_data_cmp_rb(const void *key, const struct rb_entry *entry)
+{
+    HWND key_hwnd = (HWND)key;
+    const struct ios_win_data *data = RB_ENTRY_VALUE(entry, const struct ios_win_data, entry);
+
+    if (key_hwnd < data->hwnd) return -1;
+    if (key_hwnd > data->hwnd) return 1;
+    return 0;
+}
+
+static pthread_mutex_t win_data_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct rb_tree win_data_rb = { ios_win_data_cmp_rb };
+
+/* Create win data for a top-level window (child of the desktop). Desktop and
+ * HWND_MESSAGE windows get none and fall through to default surfaces. */
+static struct ios_win_data *ios_win_data_create(HWND hwnd, const struct window_rects *rects)
+{
+    struct ios_win_data *data;
+    struct rb_entry *rb_entry;
+    HWND parent;
+
+    if (!(parent = NtUserGetAncestor(hwnd, GA_PARENT))) return NULL;
+    if (parent != NtUserGetDesktopWindow() && !NtUserGetAncestor(parent, GA_PARENT))
+        return NULL;
+
+    if (!(data = calloc(1, sizeof(*data)))) return NULL;
+
+    data->hwnd = hwnd;
+    data->rects = *rects;
+
+    pthread_mutex_lock(&win_data_mutex);
+
+    if ((rb_entry = rb_get(&win_data_rb, hwnd)))
+    {
+        free(data);
+        return RB_ENTRY_VALUE(rb_entry, struct ios_win_data, entry);
+    }
+
+    rb_put(&win_data_rb, hwnd, &data->entry);
+
+    TRACE("hwnd=%p\n", data->hwnd);
+
+    return data;
+}
+
+/* Lock and return the data for a window, or NULL. */
+static struct ios_win_data *ios_win_data_get(HWND hwnd)
+{
+    struct rb_entry *rb_entry;
+
+    pthread_mutex_lock(&win_data_mutex);
+    if ((rb_entry = rb_get(&win_data_rb, hwnd)))
+        return RB_ENTRY_VALUE(rb_entry, struct ios_win_data, entry);
+    pthread_mutex_unlock(&win_data_mutex);
+
+    return NULL;
+}
+
+static void ios_win_data_release(struct ios_win_data *data)
+{
+    assert(data);
+    pthread_mutex_unlock(&win_data_mutex);
+}
+
+void iosdrv_init_window(void)
+{
+    /* nothing yet; kept as the one-time hook for window state */
+}
+
+/***********************************************************************
+ * window surface
+ *
+ * win32u owns the DIB the guest paints into; flush() hands us the bits.
+ * We keep a stable BGRA copy (host_bits) that the app presenter reads
+ * under host_mutex, and tell the host which rect changed.
+ */
+
+struct ios_window_surface
+{
+    struct window_surface header;
+    uint64_t id;
+    void *host_bits;            /* BGRA8888 top-down, forced-opaque */
+    uint32_t width, height, stride;
+    pthread_mutex_t host_mutex; /* guards host_bits between driver and presenter */
+    unsigned int flush_count;
+    struct list entry;          /* in surface_list, for id -> hwnd lookup */
+};
+
+static pthread_mutex_t surface_list_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct list surface_list = LIST_INIT(surface_list);
+static uint64_t next_surface_id = 1;
+
+static struct ios_window_surface *ios_window_surface_cast(struct window_surface *window_surface)
+{
+    return (struct ios_window_surface *)window_surface;
+}
+
+HWND iosdrv_hwnd_from_surface_id(uint64_t id)
+{
+    struct ios_window_surface *surface;
+    HWND hwnd = 0;
+
+    pthread_mutex_lock(&surface_list_mutex);
+    LIST_FOR_EACH_ENTRY(surface, &surface_list, struct ios_window_surface, entry)
+    {
+        if (surface->id == id)
+        {
+            hwnd = surface->header.hwnd;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&surface_list_mutex);
+
+    return hwnd;
+}
+
+static void ios_surface_lock(void *lock_ctx)
+{
+    struct ios_window_surface *surface = lock_ctx;
+    pthread_mutex_lock(&surface->host_mutex);
+}
+
+static void ios_surface_unlock(void *lock_ctx)
+{
+    struct ios_window_surface *surface = lock_ctx;
+    pthread_mutex_unlock(&surface->host_mutex);
+}
+
+static void ios_window_surface_set_clip(struct window_surface *window_surface,
+                                        const RECT *rects, UINT count)
+{
+    /* v1 shows whole opaque windows; clipping is a later milestone */
+}
+
+/* Dump the surface as a bottom-up 32bpp BMP, for the headless CI harness. */
+static void dump_surface_bmp(struct ios_window_surface *surface)
+{
+    char path[512];
+    unsigned char hdr[54];
+    uint32_t image_size = surface->stride * surface->height;
+    uint32_t file_size = sizeof(hdr) + image_size;
+    FILE *f;
+    int y;
+
+    snprintf(path, sizeof(path), "%s/surface-%llu.bmp", iosdrv_dump_dir,
+             (unsigned long long)surface->id);
+    if (!(f = fopen(path, "wb"))) return;
+
+    memset(hdr, 0, sizeof(hdr));
+    hdr[0] = 'B'; hdr[1] = 'M';
+    memcpy(hdr + 2, &file_size, 4);
+    hdr[10] = 54;                       /* pixel data offset */
+    hdr[14] = 40;                       /* BITMAPINFOHEADER size */
+    memcpy(hdr + 18, &surface->width, 4);
+    memcpy(hdr + 22, &surface->height, 4);
+    hdr[26] = 1;                        /* planes */
+    hdr[28] = 32;                       /* bpp */
+    memcpy(hdr + 34, &image_size, 4);
+    fwrite(hdr, 1, sizeof(hdr), f);
+    for (y = surface->height - 1; y >= 0; y--)  /* top-down buffer -> bottom-up BMP */
+        fwrite((char *)surface->host_bits + y * surface->stride, 1, surface->stride, f);
+    fclose(f);
+}
+
+static BOOL ios_window_surface_flush(struct window_surface *window_surface, const RECT *rect,
+                                     const RECT *dirty, const BITMAPINFO *color_info,
+                                     const void *color_bits, BOOL shape_changed,
+                                     const BITMAPINFO *shape_info, const void *shape_bits)
+{
+    struct ios_window_surface *surface = ios_window_surface_cast(window_surface);
+    uint32_t src_stride = color_info->bmiHeader.biWidth * 4;
+    RECT bounds = { 0, 0, surface->width, surface->height };
+    RECT damage;
+    int y;
+
+    if (!intersect_rect(&damage, dirty, &bounds)) return TRUE;
+
+    if (iosdrv_dump_dir)  /* source geometry, for correlating CI dumps */
+        fprintf(stderr, "wineios: SRC biWidth=%d biHeight=%d sizeimage=%u rect=%d,%d-%d,%d\n",
+                (int)color_info->bmiHeader.biWidth, (int)color_info->bmiHeader.biHeight,
+                (unsigned)color_info->bmiHeader.biSizeImage,
+                (int)rect->left, (int)rect->top, (int)rect->right, (int)rect->bottom);
+
+    pthread_mutex_lock(&surface->host_mutex);
+    for (y = damage.top; y < damage.bottom; y++)
+    {
+        const uint32_t *src = (const uint32_t *)((const char *)color_bits + y * src_stride) + damage.left;
+        uint32_t *dst = (uint32_t *)((char *)surface->host_bits + y * surface->stride) + damage.left;
+        int x, width = damage.right - damage.left;
+
+        /* GDI writes XRGB with 0 alpha; the presenter composites BGRA */
+        for (x = 0; x < width; x++) dst[x] = src[x] | 0xff000000u;
+    }
+    surface->flush_count++;
+    pthread_mutex_unlock(&surface->host_mutex);
+
+    TRACE("id %llu hwnd %p dirty %s flush #%u\n", (unsigned long long)surface->id,
+          window_surface->hwnd, wine_dbgstr_rect(&damage), surface->flush_count);
+
+    if (iosdrv_host && iosdrv_host->surface_updated)
+        iosdrv_host->surface_updated(iosdrv_host->ctx, surface->id,
+                                     damage.left, damage.top, damage.right, damage.bottom);
+
+    if (iosdrv_dump_dir)
+    {
+        uint32_t checksum = 0, npx = surface->width * surface->height;
+        const uint32_t *px = surface->host_bits;
+        uint32_t i;
+
+        pthread_mutex_lock(&surface->host_mutex);
+        for (i = 0; i < npx; i++) checksum = checksum * 31 + px[i];
+        dump_surface_bmp(surface);
+        pthread_mutex_unlock(&surface->host_mutex);
+        fprintf(stderr, "wineios: FLUSH id=%llu hwnd=%p size=%ux%u dirty=%d,%d-%d,%d checksum=%08x\n",
+                (unsigned long long)surface->id, window_surface->hwnd,
+                surface->width, surface->height,
+                (int)damage.left, (int)damage.top, (int)damage.right, (int)damage.bottom,
+                checksum);
+    }
+
+    return TRUE;
+}
+
+static void ios_window_surface_destroy(struct window_surface *window_surface)
+{
+    struct ios_window_surface *surface = ios_window_surface_cast(window_surface);
+
+    TRACE("id %llu hwnd %p\n", (unsigned long long)surface->id, window_surface->hwnd);
+
+    /* After surface_removed returns the host holds no reference to bits or
+     * the lock (that is the contract), so teardown is safe. */
+    if (iosdrv_host && iosdrv_host->surface_removed)
+        iosdrv_host->surface_removed(iosdrv_host->ctx, surface->id);
+
+    pthread_mutex_lock(&surface_list_mutex);
+    list_remove(&surface->entry);
+    pthread_mutex_unlock(&surface_list_mutex);
+
+    pthread_mutex_destroy(&surface->host_mutex);
+    free(surface->host_bits);
+}
+
+static const struct window_surface_funcs ios_window_surface_funcs =
+{
+    ios_window_surface_set_clip,
+    ios_window_surface_flush,
+    ios_window_surface_destroy
+};
+
+static struct window_surface *ios_window_surface_create(HWND hwnd, const RECT *rect)
+{
+    char buffer[FIELD_OFFSET(BITMAPINFO, bmiColors[256])];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *window_surface;
+    int width = rect->right - rect->left;
+    int height = rect->bottom - rect->top;
+
+    TRACE("hwnd %p rect %s\n", hwnd, wine_dbgstr_rect(rect));
+
+    memset(info, 0, sizeof(*info));
+    info->bmiHeader.biSize        = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth       = width;
+    info->bmiHeader.biHeight      = -height; /* top-down */
+    info->bmiHeader.biPlanes      = 1;
+    info->bmiHeader.biBitCount    = 32;
+    info->bmiHeader.biSizeImage   = width * height * 4;
+    info->bmiHeader.biCompression = BI_RGB;
+
+    if ((window_surface = window_surface_create(sizeof(struct ios_window_surface),
+                                                &ios_window_surface_funcs, hwnd, rect, info, 0)))
+    {
+        struct ios_window_surface *surface = ios_window_surface_cast(window_surface);
+        pthread_mutexattr_t attr;
+
+        surface->width = width;
+        surface->height = height;
+        surface->stride = width * 4;
+        if (!(surface->host_bits = calloc(1, (size_t)surface->stride * height)))
+        {
+            window_surface_release(window_surface);
+            return NULL;
+        }
+        pthread_mutexattr_init(&attr);
+        pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
+        pthread_mutex_init(&surface->host_mutex, &attr);
+        pthread_mutexattr_destroy(&attr);
+
+        pthread_mutex_lock(&surface_list_mutex);
+        surface->id = next_surface_id++;
+        list_add_tail(&surface_list, &surface->entry);
+        pthread_mutex_unlock(&surface_list_mutex);
+
+        if (iosdrv_host && iosdrv_host->surface_added)
+        {
+            struct wineios_surface_info surface_info =
+            {
+                .id = surface->id,
+                .hwnd = (uint64_t)(UINT_PTR)hwnd,
+                .bits = surface->host_bits,
+                .width = surface->width,
+                .height = surface->height,
+                .stride = surface->stride,
+                .lock = ios_surface_lock,
+                .unlock = ios_surface_unlock,
+                .lock_ctx = surface,
+            };
+            iosdrv_host->surface_added(iosdrv_host->ctx, &surface_info);
+        }
+        if (iosdrv_dump_dir)
+            fprintf(stderr, "wineios: SURFACE_CREATED id=%llu hwnd=%p size=%dx%d\n",
+                    (unsigned long long)surface->id, hwnd, width, height);
+    }
+
+    return window_surface;
+}
+
+/***********************************************************************
+ * driver entry points
+ */
+
+BOOL IOSDRV_WindowPosChanging(HWND hwnd, UINT swp_flags, BOOL shaped, const struct window_rects *rects)
+{
+    struct ios_win_data *data = ios_win_data_get(hwnd);
+
+    TRACE("hwnd %p swp_flags %04x rects %s\n", hwnd, swp_flags, debugstr_window_rects(rects));
+
+    if (!data && !(data = ios_win_data_create(hwnd, rects))) return FALSE;
+
+    ios_win_data_release(data);
+
+    return TRUE;
+}
+
+BOOL IOSDRV_CreateWindowSurface(HWND hwnd, BOOL layered, const RECT *surface_rect,
+                                struct window_surface **surface)
+{
+    struct window_surface *previous;
+    struct ios_win_data *data;
+
+    TRACE("hwnd %p layered %u surface_rect %s\n", hwnd, layered, wine_dbgstr_rect(surface_rect));
+
+    if ((previous = *surface) && previous->funcs == &ios_window_surface_funcs) return TRUE;
+    if (!(data = ios_win_data_get(hwnd))) return TRUE;  /* use the default surface */
+    if (previous) window_surface_release(previous);
+
+    *surface = ios_window_surface_create(hwnd, surface_rect);
+    data->surface_id = *surface ? ios_window_surface_cast(*surface)->id : 0;
+
+    ios_win_data_release(data);
+    return TRUE;
+}
+
+void IOSDRV_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UINT swp_flags,
+                             const struct window_rects *new_rects, struct window_surface *surface)
+{
+    struct ios_win_data *data;
+    uint64_t surface_id;
+    BOOL visible;
+    RECT rect;
+
+    if (!(data = ios_win_data_get(hwnd))) return;
+
+    data->rects = *new_rects;
+    if (surface && surface->funcs == &ios_window_surface_funcs)
+        data->surface_id = ios_window_surface_cast(surface)->id;
+    surface_id = data->surface_id;
+    rect = new_rects->visible;
+    ios_win_data_release(data);
+
+    visible = (NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_VISIBLE) != 0;
+
+    TRACE("hwnd %p surface_id %llu rect %s visible %u\n", hwnd,
+          (unsigned long long)surface_id, wine_dbgstr_rect(&rect), visible);
+
+    if (surface_id && iosdrv_host && iosdrv_host->surface_placed)
+        iosdrv_host->surface_placed(iosdrv_host->ctx, surface_id, rect.left, rect.top,
+                                    rect.right - rect.left, rect.bottom - rect.top, visible);
+}
+
+void IOSDRV_DestroyWindow(HWND hwnd)
+{
+    struct ios_win_data *data;
+
+    TRACE("hwnd %p\n", hwnd);
+
+    if (!(data = ios_win_data_get(hwnd))) return;
+    rb_remove(&win_data_rb, &data->entry);
+    pthread_mutex_unlock(&win_data_mutex);
+    free(data);
+}
+
+LRESULT IOSDRV_DesktopWindowProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    return NtUserMessageCall(hwnd, msg, wp, lp, 0, NtUserDefWindowProc, FALSE);
+}
+
+void IOSDRV_SetWindowText(HWND hwnd, LPCWSTR text)
+{
+    if (iosdrv_host && iosdrv_host->window_title)
+        iosdrv_host->window_title(iosdrv_host->ctx, (uint64_t)(UINT_PTR)hwnd,
+                                  (const uint16_t *)text, wcslen(text));
+}
