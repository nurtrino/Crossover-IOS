+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+
+#include "iosdrv.h"
+#include "unixlib.h"
+#include "ntuser.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(iosdrv);
+
+const struct wineios_host *iosdrv_host = NULL;
+const char *iosdrv_dump_dir = NULL;
+
+static RECT screen_rect = { 0, 0, 1024, 768 };  /* headless default */
+
+RECT iosdrv_screen_rect(void)
+{
+    return screen_rect;
+}
+
+static const struct user_driver_funcs iosdrv_funcs =
+{
+    .pUpdateDisplayDevices = IOSDRV_UpdateDisplayDevices,
+    .pWindowPosChanging = IOSDRV_WindowPosChanging,
+    .pWindowPosChanged = IOSDRV_WindowPosChanged,
+    .pCreateWindowSurface = IOSDRV_CreateWindowSurface,
+    .pDestroyWindow = IOSDRV_DestroyWindow,
+    .pDesktopWindowProc = IOSDRV_DesktopWindowProc,
+    .pSetWindowText = IOSDRV_SetWindowText,
+};
+
+/* Host-wide one-time setup: resolve the app's presenter bridge and the
+ * desktop size. Multiple pseudo-processes load the driver in one host
+ * process; only the first does this work. */
+static pthread_once_t init_once = PTHREAD_ONCE_INIT;
+
+static void iosdrv_init_once(void)
+{
+    wineios_host_get_fn host_get;
+    const char *env;
+    uint32_t w, h;
+
+    if ((host_get = (wineios_host_get_fn)dlsym(RTLD_DEFAULT, WINEIOS_HOST_ENTRY)))
+    {
+        const struct wineios_host *host = host_get();
+        if (host && host->abi_version != WINEIOS_HOST_ABI_VERSION)
+        {
+            ERR("host bridge ABI mismatch: host %u, driver %u — running headless\n",
+                host->abi_version, WINEIOS_HOST_ABI_VERSION);
+            host = NULL;
+        }
+        iosdrv_host = host;
+    }
+
+    /* WINEIOS_SCREEN=WxH overrides everything (CI harness); otherwise the
+     * host app reports UIScreen.nativeBounds; otherwise keep the default. */
+    if ((env = getenv("WINEIOS_SCREEN")))
+    {
+        unsigned int ew, eh;
+        if (sscanf(env, "%ux%u", &ew, &eh) == 2 && ew && eh)
+            SetRect(&screen_rect, 0, 0, ew, eh);
+        else
+            ERR("ignoring malformed WINEIOS_SCREEN=%s\n", env);
+    }
+    else if (iosdrv_host && iosdrv_host->screen_size &&
+             iosdrv_host->screen_size(iosdrv_host->ctx, &w, &h) && w && h)
+    {
+        SetRect(&screen_rect, 0, 0, w, h);
+    }
+
+    if ((env = getenv("WINEIOS_SURFACE_DUMP")) && env[0])
+        iosdrv_dump_dir = strdup(env);
+
+    iosdrv_init_window();
+
+    TRACE("host bridge %s, screen %s, dump %s\n", iosdrv_host ? "present" : "absent (headless)",
+          wine_dbgstr_rect(&screen_rect), debugstr_a(iosdrv_dump_dir));
+}
+
+static NTSTATUS iosdrv_unix_init(void *arg)
+{
+    pthread_once(&init_once, iosdrv_init_once);
+
+    /* Registered per pseudo-process load; win32u keeps one host-wide table,
+     * so re-registering the same vtable is idempotent. */
+    __wine_set_user_driver(&iosdrv_funcs, WINE_GDI_DRIVER_VERSION);
+    return STATUS_SUCCESS;
+}
+
+/***********************************************************************
+ * Input pump
+ *
+ * Touch/keyboard events flow: UIKit (app main thread) -> host queue ->
+ * this loop (a dedicated Wine guest thread, so NtUser* is legal) ->
+ * NtUserSendHardwareInput -> the guest's message queue.
+ */
+
+static LONG input_loop_claimed;  /* every GUI process starts a pump thread; only one may drain */
+
+static HWND event_target(const struct wineios_event *ev)
+{
+    HWND hwnd = 0;
+    if (ev->surface_id) hwnd = iosdrv_hwnd_from_surface_id(ev->surface_id);
+    if (!hwnd) hwnd = NtUserGetForegroundWindow();
+    return hwnd;
+}
+
+static void inject_event(const struct wineios_event *ev)
+{
+    INPUT input = {0};
+    HWND hwnd = event_target(ev);
+
+    switch (ev->type)
+    {
+    case WINEIOS_EVENT_MOUSE_MOVE:
+        input.type = INPUT_MOUSE;
+        input.mi.dx = ev->x;
+        input.mi.dy = ev->y;
+        input.mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE;
+        break;
+    case WINEIOS_EVENT_MOUSE_BUTTON:
+        input.type = INPUT_MOUSE;
+        input.mi.dx = ev->x;
+        input.mi.dy = ev->y;
+        input.mi.dwFlags = MOUSEEVENTF_MOVE | MOUSEEVENTF_ABSOLUTE;
+        switch (ev->button)
+        {
+        case WINEIOS_BUTTON_RIGHT:
+            input.mi.dwFlags |= ev->down ? MOUSEEVENTF_RIGHTDOWN : MOUSEEVENTF_RIGHTUP;
+            break;
+        case WINEIOS_BUTTON_MIDDLE:
+            input.mi.dwFlags |= ev->down ? MOUSEEVENTF_MIDDLEDOWN : MOUSEEVENTF_MIDDLEUP;
+            break;
+        default:
+            input.mi.dwFlags |= ev->down ? MOUSEEVENTF_LEFTDOWN : MOUSEEVENTF_LEFTUP;
+            break;
+        }
+        break;
+    case WINEIOS_EVENT_MOUSE_WHEEL:
+        input.type = INPUT_MOUSE;
+        input.mi.dx = ev->x;
+        input.mi.dy = ev->y;
+        input.mi.mouseData = ev->wheel;
+        input.mi.dwFlags = MOUSEEVENTF_WHEEL;
+        break;
+    case WINEIOS_EVENT_KEY:
+        input.type = INPUT_KEYBOARD;
+        input.ki.wVk = ev->vk;
+        input.ki.dwFlags = ev->down ? 0 : KEYEVENTF_KEYUP;
+        break;
+    case WINEIOS_EVENT_CHAR:
+        input.type = INPUT_KEYBOARD;
+        input.ki.wScan = ev->ch;
+        input.ki.dwFlags = KEYEVENTF_UNICODE;
+        NtUserSendHardwareInput(hwnd, 0, &input, 0);
+        input.ki.dwFlags = KEYEVENTF_UNICODE | KEYEVENTF_KEYUP;
+        break;
+    default:
+        WARN("unknown event type %u\n", ev->type);
+        return;
+    }
+
+    TRACE("type %u hwnd %p pos %d,%d\n", ev->type, hwnd, ev->x, ev->y);
+    NtUserSendHardwareInput(hwnd, 0, &input, 0);
+}
+
+static NTSTATUS iosdrv_unix_run_input_loop(void *arg)
+{
+    if (!iosdrv_host || !iosdrv_host->next_event) return STATUS_SUCCESS;  /* headless */
+    if (InterlockedCompareExchange(&input_loop_claimed, 1, 0)) return STATUS_SUCCESS;
+
+    TRACE("input loop running\n");
+    for (;;)
+    {
+        struct wineios_event ev;
+        int ret = iosdrv_host->next_event(iosdrv_host->ctx, &ev, 500);
+        if (ret < 0) break;
+        if (ret > 0) inject_event(&ev);
+    }
+
+    InterlockedExchange(&input_loop_claimed, 0);
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    iosdrv_unix_init,
+    iosdrv_unix_run_input_loop,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == iosdrv_unix_func_count);
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    iosdrv_unix_init,
+    iosdrv_unix_run_input_loop,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_wow64_funcs) == iosdrv_unix_func_count);
+
+#endif /* _WIN64 */
