+WINE_DEFAULT_DEBUG_CHANNEL(iosdrv);
+
+/***********************************************************************
+ *      UpdateDisplayDevices (IOSDRV.@)
+ *
+ * One GPU, one source, one monitor, one fixed mode: the iOS screen at
+ * native pixel resolution (or the headless default). The device can't
+ * change modes; ChangeDisplaySettings stays on the nulldrv success path.
+ */
+UINT IOSDRV_UpdateDisplayDevices(const struct gdi_device_manager *device_manager, void *param)
+{
+    struct pci_id pci_id = {0};
+    struct gdi_monitor monitor = {0};
+    DEVMODEW mode =
+    {
+        .dmSize = sizeof(mode),
+        .dmFields = DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT |
+                    DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY | DM_POSITION,
+        .dmBitsPerPel = 32,
+        .dmDisplayFrequency = 60,
+    };
+    RECT screen = iosdrv_screen_rect();
+    UINT dpi = NtUserGetSystemDpiForProcess(NULL);
+
+    TRACE("screen %s\n", wine_dbgstr_rect(&screen));
+
+    device_manager->add_gpu("iOS Screen", &pci_id, NULL, param);
+    device_manager->add_source("iOS", DISPLAY_DEVICE_ATTACHED_TO_DESKTOP | DISPLAY_DEVICE_PRIMARY_DEVICE,
+                               dpi, param);
+
+    monitor.rc_monitor = screen;
+    monitor.rc_work = screen;
+    device_manager->add_monitor(&monitor, param);
+
+    mode.dmPelsWidth = screen.right - screen.left;
+    mode.dmPelsHeight = screen.bottom - screen.top;
+    mode.dmPosition.x = 0;
+    mode.dmPosition.y = 0;
+    device_manager->add_modes(&mode, 1, &mode, param);
+
+    return STATUS_SUCCESS;
+}
