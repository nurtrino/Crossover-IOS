+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "iosdrv_dll.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(iosdrv);
+
+/* Drains the host application's input queue and injects it as hardware
+ * input. This must run on a Wine guest thread (never the app main thread),
+ * so it lives here: a plain Windows thread that blocks in the unixlib.
+ * Returns when there is no host bridge (headless) or the host asks to stop. */
+static DWORD WINAPI iosdrv_input_thread(void *arg)
+{
+    IOSDRV_UNIX_CALL(run_input_loop, NULL);
+    TRACE("input loop finished\n");
+    return 0;
+}
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    DWORD tid;
+
+    if (reason != DLL_PROCESS_ATTACH) return TRUE;
+
+    DisableThreadLibraryCalls(instance);
+    if (__wine_init_unix_call()) return FALSE;
+
+    if (IOSDRV_UNIX_CALL(init, NULL))
+        return FALSE;
+
+    CloseHandle(CreateThread(NULL, 0, iosdrv_input_thread, NULL, 0, &tid));
+
+    return TRUE;
+}
