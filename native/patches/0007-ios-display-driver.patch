+
+/* One process-wide bridge to the embedding app; NULL when headless.
+ * The unixlib is dlopen'ed once per host process and shared by every
+ * pseudo-process, so this state is host-wide by construction. */
+extern const struct wineios_host *iosdrv_host;
+
+/* The screen rectangle the Windows desktop runs at, in pixels, origin 0,0. */
+extern RECT iosdrv_screen_rect(void);
+
+/* Directory to dump surface BMPs into on flush (WINEIOS_SURFACE_DUMP), or
+ * NULL. Headless CI uses this to prove end-to-end pixel flow. */
+extern const char *iosdrv_dump_dir;
+
+static inline BOOL intersect_rect(RECT *dst, const RECT *src1, const RECT *src2)
+{
+    dst->left = max(src1->left, src2->left);
+    dst->top = max(src1->top, src2->top);
+    dst->right = min(src1->right, src2->right);
+    dst->bottom = min(src1->bottom, src2->bottom);
+    return !IsRectEmpty(dst);
+}
+
+/* window.c */
+extern void iosdrv_init_window(void);
+extern HWND iosdrv_hwnd_from_surface_id(uint64_t id);
+
+/* driver entry points (window.c) */
+extern BOOL IOSDRV_WindowPosChanging(HWND hwnd, UINT swp_flags, BOOL shaped,
+                                     const struct window_rects *rects);
+extern void IOSDRV_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint,
+                                    UINT swp_flags, const struct window_rects *new_rects,
+                                    struct window_surface *surface);
+extern BOOL IOSDRV_CreateWindowSurface(HWND hwnd, BOOL layered, const RECT *surface_rect,
+                                       struct window_surface **surface);
+extern void IOSDRV_DestroyWindow(HWND hwnd);
+extern LRESULT IOSDRV_DesktopWindowProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp);
+extern void IOSDRV_SetWindowText(HWND hwnd, LPCWSTR text);
+
+/* driver entry points (display.c) */
+extern UINT IOSDRV_UpdateDisplayDevices(const struct gdi_device_manager *device_manager,
+                                        void *param);
+
+#endif /* __WINE_IOSDRV_H */
