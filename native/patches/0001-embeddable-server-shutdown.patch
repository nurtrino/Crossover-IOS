diff --git a/server/main.c b/server/main.c
index 46419a0..746e1bc 100644
--- a/server/main.c
+++ b/server/main.c
@@ -23,6 +23,7 @@
 #include <assert.h>
 #include <ctype.h>
 #include <fcntl.h>
+#include <setjmp.h>
 #include <signal.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -241,7 +242,33 @@ static void init_limits(void)
 #endif
 }
 
-int main( int argc, char *argv[] )
+/*
+ * Embeddable-shutdown support (Crossover-IOS fork).
+ *
+ * iOS forbids fork/exec, so wineserver must run in-process (as a thread in
+ * the host app). Its shutdown paths historically funnel through exit(),
+ * which would tear down the whole host. server_exit() lets the runtime
+ * shutdown paths (close_socket_timeout, fatal_error, SIGTERM) unwind back
+ * to wineserver_run() instead, leaving the host process alive.
+ *
+ * When not embedded (the standalone wineserver binary), server_exit() is a
+ * straight exit(), so behavior is byte-for-byte unchanged.
+ */
+static jmp_buf server_exit_jmp;
+static int server_embedded;
+static int server_exit_status;
+
+void server_exit( int status )
+{
+    if (server_embedded)
+    {
+        server_exit_status = status;
+        longjmp( server_exit_jmp, 1 );
+    }
+    exit( status );
+}
+
+static void server_body( int argc, char *argv[] )
 {
     setvbuf( stderr, NULL, _IOLBF, 0 );
     server_argv0 = argv[0];
@@ -267,5 +294,26 @@ int main( int argc, char *argv[] )
     init_threading();
     init_registry();
     main_loop();
+}
+
+int main( int argc, char *argv[] )
+{
+    server_body( argc, argv );
     return 0;
 }
+
+/* Embeddable entry point: run the server, returning its exit status instead
+ * of terminating the process. See server_exit() above. */
+int wineserver_run( int argc, char *argv[] )
+{
+    server_embedded = 1;
+    server_exit_status = 0;
+    if (setjmp( server_exit_jmp ))
+    {
+        server_embedded = 0;
+        return server_exit_status;
+    }
+    server_body( argc, argv );
+    server_embedded = 0;
+    return server_exit_status;
+}
