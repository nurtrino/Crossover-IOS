-    exit(1);
+    server_exit(1);
 }
 
 /* allocate the reply data */
@@ -572,8 +572,10 @@ static void master_socket_poll_event( struct fd *fd, int event )
 /* remove the socket upon exit */
 static void socket_cleanup(void)
 {
-    static int do_it_once;
-    if (!do_it_once++) unlink( server_socket_name );
+    /* Idempotent by construction (unlink of a missing socket is harmless),
+     * so no once-guard: the embeddable shutdown may call this per cycle and
+     * atexit may call it again in the standalone binary. */
+    unlink( server_socket_name );
 }
 
 /* create a directory and check its permissions */
@@ -912,7 +914,11 @@ static void close_socket_timeout( void *arg )
 #ifdef DEBUG_OBJECTS
     close_objects();  /* shut down everything properly */
 #endif
-    exit( 0 );
+    /* When embedded, server_exit() unwinds via longjmp and the atexit
+     * socket_cleanup never runs, leaving a stale socket that breaks the
+     * next wineserver_run(). Unlink it here so restart starts clean. */
+    socket_cleanup();
+    server_exit( 0 );
 }
 
 /* close the master socket and stop waiting for new clients */
